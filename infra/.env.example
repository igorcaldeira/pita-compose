# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored (holds secrets). This template is committed for reference.

# ── General ──────────────────────────────────────────
TZ=America/Sao_Paulo

# ── DuckDNS (dynamic DNS) ───────────────────────────
# Free DDNS so WG_HOST has a stable name that tracks this home's public IP.
# Register at https://www.duckdns.org (login, pick a subdomain, copy the token).
# SUBDOMAINS is just the name, no ".duckdns.org" (e.g. pitangui).
DUCKDNS_SUBDOMAIN=pitangui
DUCKDNS_TOKEN=REPLACE_WITH_YOUR_DUCKDNS_TOKEN

# ── WireGuard (WG-Easy) ─────────────────────────────
# WG_HOST: public endpoint clients connect to from anywhere (5G, other WiFi).
# Use the DuckDNS hostname and forward UDP 51820 on the router to this server.
# NOTE: only works if your router's WAN IP is a real public IP (not CGNAT).
WG_HOST=pitangui.duckdns.org
# Generate with:  docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'yourpassword'
# Note: in this file every literal $ must be doubled ($$) for docker compose.
WG_PASSWORD_HASH=$$2a$$12$$REPLACE_WITH_YOUR_BCRYPT_HASH
WG_DEFAULT_DNS=10.10.0.2
WG_PORT=51820
WG_UI_PORT=51821
# Split tunnel (lab subnet only). Add ,192.168.10.0/24 later for full LAN access.
WG_ALLOWED_IPS=10.10.0.0/24

# ── Pi-hole ──────────────────────────────────────────
PIHOLE_PASSWORD=changeme
PIHOLE_UI_PORT=8080

# ── Code Server ──────────────────────────────────────
CODESERVER_PASSWORD=changeme

# ── Portainer ────────────────────────────────────────
PORTAINER_ADMIN_PASSWORD=changeme

# ── FileBrowser ─────────────────────────────────────
FILEBROWSER_PASSWORD=changeme

# ── RustDesk (remote desktop) ───────────────────────
# Permanent password set on THIS host by infra/scripts/setup-rustdesk-client.sh.
# Leave as changeme to be prompted instead of storing it in a file.
RUSTDESK_PASSWORD=changeme

# ── Valheim Server ────────────────────────────────
# Runs on a separate network (no VPN). Exposed directly on UDP 2456-2457.
VALHEIM_PORT=2456
